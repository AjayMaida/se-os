# ============================================================
# SE-OS Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to version control
# ============================================================

# ─────────────────────────────────────────
# Application
# ─────────────────────────────────────────
APP_ENV=development
APP_NAME=SE-OS
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=debug

# ─────────────────────────────────────────
# Backend API (FastAPI)
# ─────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Secret key for JWT signing (generate with: openssl rand -hex 32)
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ─────────────────────────────────────────
# Database (PostgreSQL)
# ─────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=seos
POSTGRES_USER=seos_user
POSTGRES_PASSWORD=CHANGE_ME_strong_password
DATABASE_URL=postgresql+asyncpg://seos_user:CHANGE_ME_strong_password@postgres:5432/seos

# PgBouncer (connection pooler)
PGBOUNCER_HOST=pgbouncer
PGBOUNCER_PORT=5433

# ─────────────────────────────────────────
# Redis
# ─────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_URL=redis://:CHANGE_ME_redis_password@redis:6379/0

# Cache TTL defaults (seconds)
CACHE_TTL_SHORT=300        # 5 minutes
CACHE_TTL_MEDIUM=3600      # 1 hour
CACHE_TTL_LONG=86400       # 24 hours

# ─────────────────────────────────────────
# Message Broker (RabbitMQ)
# ─────────────────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=seos_rabbit
RABBITMQ_PASSWORD=CHANGE_ME_rabbit_password
RABBITMQ_VHOST=/
RABBITMQ_URL=amqp://seos_rabbit:CHANGE_ME_rabbit_password@rabbitmq:5672/

# ─────────────────────────────────────────
# AI Platform
# ─────────────────────────────────────────
AI_PLATFORM_HOST=ai-platform
AI_PLATFORM_PORT=8001
AI_PLATFORM_URL=http://ai-platform:8001

# LLM Providers (via LiteLLM)
OPENAI_API_KEY=sk-CHANGE_ME
ANTHROPIC_API_KEY=CHANGE_ME
GOOGLE_API_KEY=CHANGE_ME

# Default model configuration
AI_DEFAULT_MODEL=gpt-4o-mini
AI_COMPLEX_MODEL=gpt-4o
AI_EMBEDDING_MODEL=text-embedding-3-small

# AI limits
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7
AI_RATE_LIMIT_PER_USER_PER_MINUTE=20

# LangSmith (optional: AI observability)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=CHANGE_ME
LANGCHAIN_PROJECT=se-os

# ─────────────────────────────────────────
# Object Storage (MinIO locally / S3 in prod)
# ─────────────────────────────────────────
STORAGE_PROVIDER=minio
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_ROOT_USER=seos_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password
MINIO_BUCKET_VIDEOS=se-os-videos
MINIO_BUCKET_RESUMES=se-os-resumes
MINIO_BUCKET_EXPORTS=se-os-exports

# S3 (for production)
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_REGION=ap-south-1
S3_BUCKET_NAME=se-os-prod

# ─────────────────────────────────────────
# Authentication (OAuth)
# ─────────────────────────────────────────
# Google OAuth
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME

# GitHub OAuth (for GitHub integration)
GITHUB_CLIENT_ID=CHANGE_ME
GITHUB_CLIENT_SECRET=CHANGE_ME
GITHUB_WEBHOOK_SECRET=CHANGE_ME

# NextAuth (frontend)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# ─────────────────────────────────────────
# Frontend (Next.js)
# ─────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=SE-OS
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AI_URL=http://localhost:8001

# ─────────────────────────────────────────
# Notifications
# ─────────────────────────────────────────
# Email (Resend)
RESEND_API_KEY=re_CHANGE_ME
EMAIL_FROM=noreply@se-os.app
EMAIL_FROM_NAME=SE-OS

# Web Push (VAPID keys)
VAPID_PUBLIC_KEY=CHANGE_ME
VAPID_PRIVATE_KEY=CHANGE_ME
VAPID_SUBJECT=mailto:support@se-os.app

# ─────────────────────────────────────────
# External Integrations
# ─────────────────────────────────────────
# LeetCode (unofficial API / scraping)
LEETCODE_API_URL=https://leetcode.com/graphql

# ─────────────────────────────────────────
# Observability
# ─────────────────────────────────────────
# Sentry (error tracking)
SENTRY_DSN=CHANGE_ME
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ─────────────────────────────────────────
# Code Execution (Interview Studio)
# ─────────────────────────────────────────
# Piston API (self-hosted or public)
CODE_EXECUTION_URL=http://piston:2000
CODE_EXECUTION_TIMEOUT=30

# ─────────────────────────────────────────
# Whisper (Audio Transcription)
# ─────────────────────────────────────────
WHISPER_MODEL=whisper-1
# Uses OpenAI API key above

# ─────────────────────────────────────────
# Feature Flags
# ─────────────────────────────────────────
FEATURE_INTERVIEW_STUDIO=true
FEATURE_GITHUB_INTEGRATION=true
FEATURE_LEETCODE_INTEGRATION=true
FEATURE_AI_CODE_REVIEW=false
FEATURE_COMMUNITY=false
FEATURE_MOCK_INTERVIEWS=false
